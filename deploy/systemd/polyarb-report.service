[Unit]
Description=Polyarb Bericht aller Strategien (realisiert gesamt und letzte 4 h)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=polyarb
WorkingDirectory=/opt/polyarb
EnvironmentFile=/etc/polyarb.env
ExecStart=/opt/polyarb/.venv/bin/python deploy/notify.py report 4
