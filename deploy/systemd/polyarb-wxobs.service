[Unit]
Description=Polyarb Wetter-Messwert-Studie (Stationswerte gegen Polymarket-Preise)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=polyarb
WorkingDirectory=/opt/polyarb
EnvironmentFile=/etc/polyarb.env
ExecStart=/opt/polyarb/.venv/bin/python run.py wxobs --max-new 3000
TimeoutStartSec=4h
Nice=10
