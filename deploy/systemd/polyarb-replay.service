[Unit]
Description=Polyarb Replay-Labor: MM-Regeln auf dem Orderbuch-Mitschnitt, walk-forward
[Service]
Type=oneshot
User=polyarb
# batch job: below the trading in CPU and memory, killed first when RAM runs out
Nice=19
OOMScoreAdjust=500
MemoryMax=400M
WorkingDirectory=/opt/polyarb
EnvironmentFile=/etc/polyarb.env
ExecStart=/opt/polyarb/.venv/bin/python -m arb.replaylab
TimeoutStartSec=1h
