[Unit]
Description=Polyarb paper trading bot
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=polyarb
OOMScoreAdjust=-300
WorkingDirectory=/opt/polyarb
EnvironmentFile=/etc/polyarb.env
ExecStart=/opt/polyarb/.venv/bin/python run.py paper
Restart=always
RestartSec=30
[Install]
WantedBy=multi-user.target
